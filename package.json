{
  "name": "journey-failure-receipts",
  "version": "0.1.0",
  "description": "Scrubbed assertion-level evidence receipts for Playwright journeys",
  "license": "MIT",
  "author": "Sociobot (Param Factory)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "playwright",
    "testing",
    "reporter",
    "debugging",
    "soft-assertions"
  ],
  "main": "./dist/package/index.cjs",
  "module": "./dist/package/index.js",
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "import": "./dist/package/index.js",
      "require": "./dist/package/index.cjs"
    },
    "./playwright": {
      "types": "./dist/package/playwright.d.ts",
      "import": "./dist/package/playwright.js",
      "require": "./dist/package/playwright.cjs"
    },
    "./reporter": {
      "types": "./dist/package/reporter.d.ts",
      "import": "./dist/package/reporter.js",
      "require": "./dist/package/reporter.cjs"
    }
  },
  "files": [
    "dist/package",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build:package": "tsup",
    "build:site": "vite build",
    "build": "npm run build:package && npm run build:site",
    "test:unit": "vitest run",
    "test:e2e": "node tests/run-fixture-smoke.mjs",
    "test:site": "playwright test --config tests/site/playwright.config.ts",
    "test": "npm run test:unit && npm run test:e2e && npm run test:site",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/instrument-sans": "^5.2.7",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "playwright-core": "^1.58.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
